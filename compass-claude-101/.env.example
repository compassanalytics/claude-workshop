# Compass Claude 101 — example environment.
# Copy to .env (gitignored). The block-secrets hook refuses to commit
# any file matching .env, .key, .pem, etc.

# --- Backend (the FastAPI service) ---
DATABASE_URL=sqlite:///./compass.db
JWT_SECRET=change-me-in-prod
LOG_LEVEL=INFO

# --- Atlassian MCP server (referenced by .claude/.mcp.json) ---
# These are interpolated into .mcp.json's env block via ${VAR} syntax.
# Claude Code only reads them from the SHELL — see DEMOS.md Part 4 for how
# to load them (shell rc, `set -a; source .env; set +a; claude`, or direnv).
JIRA_URL=https://your-company.atlassian.net
JIRA_USERNAME=you@your-company.com
JIRA_API_TOKEN=ATATT3xFf...replace
CONFLUENCE_URL=https://your-company.atlassian.net/wiki
CONFLUENCE_USERNAME=you@your-company.com
CONFLUENCE_API_TOKEN=ATATT3xFf...replace
